# ---------------------------------------------------------------
# JobConnect Rwanda - backend configuration
# Copy this file to .env and replace every placeholder value.
# Never commit your real .env file.
# ---------------------------------------------------------------

PORT=5000
NODE_ENV=development

# Local:  mongodb://127.0.0.1:27017/jobconnect_rwanda
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jobconnect_rwanda?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string

# Separate database used ONLY by the automated tests (the name must contain "test").
MONGO_URI_TEST=mongodb://127.0.0.1:27017/jobconnect_test

# Use a long random value, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Frontend origin(s). Separate several origins with commas.
CLIENT_URL=http://localhost:5173

# Optional - email notifications / password reset emails (leave blank to disable)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email
EMAIL_PASS=your_email_app_password
EMAIL_FROM="JobConnect Rwanda <no-reply@jobconnect.rw>"